<!-- ═══ JAVASCRIPT ═════════════════════════════════════════════════════════════ -->
<script>
  // ── Year ──
  document.getElementById('year').textContent = new Date().getFullYear();

  // ── Scroll reveal ──
  const revealObs = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.10, rootMargin: '0px 0px -48px 0px' }
  );
  document.querySelectorAll('.reveal').forEach((el) => revealObs.observe(el));

  // ── Sticky header ──
  const header = document.getElementById('header');
  window.addEventListener('scroll', () => {
    header.classList.toggle('scrolled', window.scrollY > 32);
  }, { passive: true });

  // ── Smooth scroll ──
  function scrollTo(id) {
    document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
  }

  // ── Mobile menu ──
  function toggleMenu() {
    const menu = document.getElementById('mobile-menu');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');
    const isOpen = menu.classList.toggle('open');
    iconMenu.style.display = isOpen ? 'none' : 'inline-block';
    iconClose.style.display = isOpen ? 'inline-block' : 'none';
  }

  // ── Testimonials ──
  const TESTIMONIALS = [
    { src: 'depoimentos/01.jpg', alt: 'Depoimento 1' },
    { src: 'depoimentos/02.jpg', alt: 'Depoimento 2' },
    { src: 'depoimentos/03.jpg', alt: 'Depoimento 3' },
    { src: 'depoimentos/04.jpg', alt: 'Depoimento 4' },
    { src: 'depoimentos/05.jpg', alt: 'Depoimento 5' },
  ];
  let currentT = 0;
  let tTimer = null;

  function buildTestimonialUI() {
    const dotsEl = document.getElementById('testimonial-dots');
    const thumbsEl = document.getElementById('testimonial-thumbs');
    dotsEl.innerHTML = '';
    thumbsEl.innerHTML = '';
    TESTIMONIALS.forEach((t, i) => {
      const dot = document.createElement('button');
      dot.className = 'testimonial-dot' + (i === currentT ? ' active' : '');
      dot.setAttribute('aria-label', 'Ver depoimento ' + (i + 1));
      dot.onclick = () => goTestimonial(i);
      dotsEl.appendChild(dot);

      const thumb = document.createElement('button');
      thumb.className = 'testimonial-thumb' + (i === currentT ? ' active' : '');
      thumb.setAttribute('aria-label', 'Ver depoimento ' + (i + 1));
      thumb.onclick = () => goTestimonial(i);
      const img = document.createElement('img');
      img.src = t.src; img.alt = t.alt; img.loading = 'lazy';
      thumb.appendChild(img);
      thumbsEl.appendChild(thumb);
    });
  }

  function goTestimonial(idx) {
    const imgEl = document.getElementById('testimonial-img');
    imgEl.style.opacity = '0';
    setTimeout(() => {
      currentT = idx;
      imgEl.src = TESTIMONIALS[currentT].src;
      imgEl.alt = TESTIMONIALS[currentT].alt;
      imgEl.style.opacity = '1';
      buildTestimonialUI();
    }, 220);
    resetTTimer();
  }

  function testimonialNext() { goTestimonial((currentT + 1) % TESTIMONIALS.length); }
  function testimonialPrev() { goTestimonial((currentT - 1 + TESTIMONIALS.length) % TESTIMONIALS.length); }

  function resetTTimer() {
    if (tTimer) clearInterval(tTimer);
    tTimer = setInterval(testimonialNext, 5500);
  }

  document.getElementById('testimonial-img').style.transition = 'opacity 0.22s';
  buildTestimonialUI();
  resetTTimer();

  // ── FAQ accordion ──
  function toggleFaq(idx) {
    const body = document.getElementById('faq-body-' + idx);
    const chevron = document.getElementById('faq-chevron-' + idx);
    const isOpen = body.classList.toggle('open');
    chevron.classList.toggle('open', isOpen);
  }
</script>
