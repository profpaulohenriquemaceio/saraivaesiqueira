<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Saraiva &amp; Siqueira — Advocacia Previdenciária</title>
  <meta name="description" content="Escritório de advocacia previdenciária em Maceió/AL. Especialistas em aposentadoria, BPC/LOAS, revisão de benefícios e planejamento previdenciário." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* ── Reset & Base ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
    body {
      background: #fff;
      color: #1a2744;
      font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
      font-size: 1rem;
      line-height: 1.6;
    }
    h1,h2,h3,h4,h5,h6 {
      font-family: "Poppins", ui-sans-serif, system-ui, sans-serif;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.1;
      color: #1a2744;
    }
    a { text-decoration: none; }
    img { max-width: 100%; display: block; }
    button { cursor: pointer; font-family: inherit; }
    ::selection { background: #fdf4e0; color: #1a2744; }

    /* ── Design Tokens ── */
    :root {
      --navy:        #1a2744;
      --navy-mid:    #253460;
      --navy-light:  #3a4f8a;
      --gold:        #c9a84c;
      --gold-light:  #e0c070;
      --gold-pale:   #fdf4e0;
      --whatsapp:    #25d366;
      --whatsapp-dk: #1da851;
      --ease-out:    cubic-bezier(0.23, 1, 0.32, 1);
    }

    /* ── Layout ── */
    .container {
      width: 100%;
      max-width: 1160px;
      margin-inline: auto;
      padding-inline: clamp(1.25rem, 5vw, 2.5rem);
    }
    .section-py { padding-top: clamp(5rem, 10vw, 8rem); padding-bottom: clamp(5rem, 10vw, 8rem); }

    /* ── Backgrounds ── */
    .bg-off      { background-color: #f7f8fb; }
    .gradient-hero { background: linear-gradient(160deg, #111c38 0%, #1e2f5c 60%, #172040 100%); }
    .gradient-navy { background: linear-gradient(160deg, #141e3a 0%, #1e2f5c 100%); }
    .dot-grid {
      background-image: radial-gradient(circle, rgba(26,39,68,0.06) 1px, transparent 0);
      background-size: 28px 28px;
    }

    /* ── Buttons ── */
    .btn-gold {
      display: inline-flex; align-items: center; justify-content: center;
      gap: 0.625rem; padding: 0.875rem 2rem; border-radius: 100px;
      font-family: "Poppins", sans-serif; font-weight: 600; font-size: 0.9375rem;
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
      color: var(--navy); box-shadow: 0 4px 20px rgba(201,168,76,0.40);
      transition: transform 0.15s var(--ease-out), box-shadow 0.15s; white-space: nowrap;
    }
    .btn-gold:hover { transform: scale(1.03); box-shadow: 0 8px 28px rgba(201,168,76,0.50); }
    .btn-gold:active { transform: scale(0.97); }

    .btn-ghost-white {
      display: inline-flex; align-items: center; justify-content: center;
      gap: 0.625rem; padding: 0.875rem 2rem; border-radius: 100px;
      font-family: "Poppins", sans-serif; font-weight: 600; font-size: 0.9375rem;
      background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.35);
      transition: background 0.2s, border-color 0.2s, transform 0.15s; white-space: nowrap;
    }
    .btn-ghost-white:hover { background: rgba(255,255,255,0.10); border-color: rgba(255,255,255,0.60); transform: scale(1.02); }

    .btn-whatsapp {
      display: inline-flex; align-items: center; justify-content: center;
      gap: 0.625rem; padding: 0.875rem 2rem; border-radius: 100px;
      font-family: "Poppins", sans-serif; font-weight: 600; font-size: 0.9375rem;
      background: var(--whatsapp); color: #fff;
      box-shadow: 0 4px 20px rgba(37,211,102,0.35);
      transition: background 0.2s, transform 0.15s, box-shadow 0.15s; white-space: nowrap;
    }
    .btn-whatsapp:hover { background: var(--whatsapp-dk); transform: scale(1.03); box-shadow: 0 8px 28px rgba(37,211,102,0.45); }
    .btn-whatsapp:active { transform: scale(0.97); }

    /* ── Pills ── */
    .pill {
      display: inline-flex; align-items: center; gap: 0.375rem;
      padding: 0.375rem 0.875rem; border-radius: 100px;
      font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    }
    .pill-gold  { background: var(--gold-pale); color: #8a6c1a; }
    .pill-navy  { background: #eef0f7; color: var(--navy-light); }
    .pill-white { background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.80); border: 1px solid rgba(255,255,255,0.20); }

    /* ── Gold divider ── */
    .gold-divider {
      width: 3.5rem; height: 3px; border-radius: 2px;
      background: linear-gradient(90deg, var(--gold), var(--gold-light));
    }

    /* ── Gold number ── */
    .gold-number {
      width: 2.75rem; height: 2.75rem; border-radius: 50%;
      background: var(--gold); color: var(--navy);
      font-family: "Poppins", sans-serif; font-weight: 700; font-size: 0.875rem;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
      box-shadow: 0 4px 16px rgba(201,168,76,0.35);
    }

    /* ── Cards ── */
    .card-clean {
      background: #fff; border: 1px solid #eaecf4; border-radius: 1.25rem;
      transition: box-shadow 0.25s var(--ease-out), transform 0.25s var(--ease-out), border-color 0.25s;
    }
    .card-clean:hover {
      box-shadow: 0 12px 40px rgba(26,39,68,0.10);
      transform: translateY(-3px); border-color: var(--gold-light);
    }

    /* ── Scroll reveal ── */
    .reveal {
      opacity: 0; transform: translateY(36px);
      transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .delay-1 { transition-delay: 80ms !important; }
    .delay-2 { transition-delay: 160ms !important; }
    .delay-3 { transition-delay: 240ms !important; }
    .delay-4 { transition-delay: 320ms !important; }

    /* ── SVG icons inline ── */
    .icon { display: inline-block; vertical-align: middle; flex-shrink: 0; }

    /* ── Header ── */
    #header {
      position: fixed; top: 0; left: 0; right: 0; z-index: 50;
      transition: background 0.35s, box-shadow 0.35s, backdrop-filter 0.35s;
    }
    #header.scrolled {
      background: rgba(255,255,255,0.96);
      backdrop-filter: blur(16px);
      box-shadow: 0 1px 0 #eaecf4;
    }
    .header-inner {
      display: flex; align-items: center; justify-content: space-between;
      height: 76px; transition: height 0.35s;
    }
    #header.scrolled .header-inner { height: 64px; }
    .logo-mark {
      width: 2.25rem; height: 2.25rem; border-radius: 0.625rem;
      background: linear-gradient(160deg, #1a2744, #253460);
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 2px 10px rgba(26,39,68,0.30); flex-shrink: 0;
    }
    .logo-name {
      font-family: "Poppins", sans-serif; font-weight: 700; font-size: 0.9375rem;
      letter-spacing: -0.01em; color: white; line-height: 1.2;
      transition: color 0.3s;
    }
    .logo-sub {
      font-size: 0.625rem; font-weight: 600; letter-spacing: 0.12em;
      text-transform: uppercase; color: rgba(255,255,255,0.65); transition: color 0.3s;
    }
    #header.scrolled .logo-name { color: var(--navy); }
    #header.scrolled .logo-sub  { color: var(--navy-light); }

    .nav-desktop { display: flex; align-items: center; gap: 0.25rem; }
    .nav-btn {
      padding: 0.5rem 1rem; border-radius: 100px; border: none;
      font-family: "Inter", sans-serif; font-size: 0.875rem; font-weight: 500;
      background: transparent; color: rgba(255,255,255,0.85); transition: background 0.2s, color 0.2s;
    }
    .nav-btn:hover { background: rgba(255,255,255,0.10); }
    #header.scrolled .nav-btn { color: var(--navy); }
    #header.scrolled .nav-btn:hover { background: #f7f8fb; }

    .mobile-toggle {
      display: none; padding: 0.5rem; background: none; border: none; color: white;
    }
    #header.scrolled .mobile-toggle { color: var(--navy); }

    #mobile-menu {
      display: none; background: white; border-top: 1px solid #eaecf4;
      box-shadow: 0 8px 32px rgba(26,39,68,0.12);
    }
    #mobile-menu.open { display: block; }
    .mobile-nav-btn {
      display: block; width: 100%; text-align: left; padding: 0.75rem 1rem;
      border-radius: 0.75rem; border: none; background: none;
      font-family: "Inter", sans-serif; font-size: 0.9375rem; font-weight: 500; color: var(--navy);
    }

    @media (max-width: 767px) {
      .nav-desktop { display: none; }
      .mobile-toggle { display: block; }
    }

    /* ── Hero ── */
    #hero {
      position: relative; min-height: 100svh; display: flex; align-items: center; overflow: hidden;
    }
    .hero-grid {
      display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center;
      padding-top: clamp(6rem, 12vw, 8rem); padding-bottom: clamp(4rem, 8vw, 6rem);
    }
    @media (min-width: 768px) {
      .hero-grid { grid-template-columns: 1fr 1fr; }
    }
    .hero-blob-1 {
      position: absolute; top: 15%; right: -5%;
      width: clamp(300px, 45vw, 600px); height: clamp(300px, 45vw, 600px);
      border-radius: 50%;
      background: radial-gradient(circle, rgba(201,168,76,0.18) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-blob-2 {
      position: absolute; bottom: -10%; left: -5%;
      width: clamp(200px, 30vw, 400px); height: clamp(200px, 30vw, 400px);
      border-radius: 50%;
      background: radial-gradient(circle, rgba(37,52,96,0.15) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-img-wrap {
      position: relative; border-radius: 1.5rem; overflow: hidden;
      box-shadow: 0 32px 80px rgba(26,39,68,0.45);
    }
    .hero-img-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(20,30,56,0.55) 0%, transparent 50%);
    }
    .hero-img-badge {
      position: absolute; bottom: 1.25rem; left: 1.25rem;
      background: rgba(255,255,255,0.12); backdrop-filter: blur(12px);
      border: 1px solid rgba(255,255,255,0.25); border-radius: 100px;
      padding: 0.5rem 1.125rem; display: flex; align-items: center; gap: 0.5rem;
    }
    .stats-row {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 2.5rem;
    }
    @media (min-width: 480px) {
      .stats-row { grid-template-columns: repeat(4, 1fr); }
    }
    .stat-item { display: flex; flex-direction: column; }
    .stat-value {
      font-family: "Poppins", sans-serif; font-weight: 800;
      font-size: clamp(1.75rem, 3.5vw, 2.5rem); color: white; line-height: 1;
    }
    .stat-label { font-size: 0.8125rem; color: rgba(255,255,255,0.55); margin-top: 0.25rem; }

    /* ── Gold Path Connector ── */
    .gold-connector {
      display: flex; flex-direction: column; align-items: center;
      height: 4rem; position: relative; z-index: 2;
    }
    .gold-connector-line {
      width: 2px; flex: 1;
      background: linear-gradient(to bottom, transparent, var(--gold) 50%, transparent);
    }
    .gold-connector-dot {
      width: 10px; height: 10px; border-radius: 50%;
      background: var(--gold); box-shadow: 0 0 0 3px var(--gold-pale); flex-shrink: 0;
    }

    /* ── ProofBar ── */
    #proofbar { background: var(--navy); overflow: hidden; }
    .proofbar-inner {
      display: flex; flex-wrap: wrap; justify-content: center;
      align-items: center; gap: clamp(1.5rem, 4vw, 3.5rem);
      padding-top: 1.75rem; padding-bottom: 1.75rem;
    }
    .proof-item { display: flex; align-items: center; gap: 0.625rem; }
    .proof-item span { color: rgba(255,255,255,0.80); font-size: 0.8125rem; font-weight: 500; white-space: nowrap; }

    /* ── Services ── */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
      gap: 1.25rem;
    }
    .service-card { padding: 2rem; }
    .service-icon-wrap {
      width: 3rem; height: 3rem; border-radius: 0.875rem;
      background: var(--gold-pale);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 1.25rem;
    }

    /* ── Differentials ── */
    .diff-grid {
      display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center;
    }
    @media (min-width: 768px) { .diff-grid { grid-template-columns: 1fr 1fr; } }
    .diff-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .diff-card { padding: 1.75rem; }
    .diff-icon-wrap {
      width: 2.75rem; height: 2.75rem; border-radius: 0.75rem;
      background: linear-gradient(135deg, var(--navy), var(--navy-mid));
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 1.125rem;
      box-shadow: 0 4px 14px rgba(26,39,68,0.25);
    }

    /* ── Journey ── */
    .journey-timeline { max-width: 720px; margin: 0 auto; position: relative; }
    .journey-vline {
      position: absolute; left: 1.3125rem; top: 2rem; bottom: 2rem;
      width: 2px;
      background: linear-gradient(to bottom, var(--gold) 0%, var(--gold-light) 100%);
      border-radius: 2px;
    }
    .journey-steps { display: flex; flex-direction: column; gap: 2.5rem; }
    .journey-step { display: flex; gap: 1.75rem; align-items: flex-start; }
    .journey-step-content {
      flex: 1; padding: 1.625rem 1.875rem;
      display: flex; gap: 1.25rem; align-items: flex-start;
    }
    .journey-step-icon {
      width: 2.75rem; height: 2.75rem; border-radius: 0.75rem;
      background: var(--gold-pale);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    @media (max-width: 639px) { .journey-vline { display: none; } }

    /* ── Testimonials ── */
    .testimonials-wrap { max-width: 680px; margin: 0 auto; }
    .testimonial-main {
      position: relative; border-radius: 1.5rem; overflow: hidden;
      box-shadow: 0 20px 60px rgba(26,39,68,0.14); background: white;
    }
    .testimonial-img { width: 100%; height: auto; max-height: 520px; object-fit: contain; display: block; background: white; }
    .testimonial-arrow {
      position: absolute; top: 50%; transform: translateY(-50%);
      width: 2.75rem; height: 2.75rem; border-radius: 50%;
      background: rgba(255,255,255,0.92); backdrop-filter: blur(8px);
      border: 1px solid #eaecf4; display: flex; align-items: center; justify-content: center;
      cursor: pointer; color: var(--navy);
      box-shadow: 0 4px 16px rgba(26,39,68,0.14);
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .testimonial-arrow:hover { transform: translateY(-50%) scale(1.08); }
    .testimonial-arrow.left { left: 1rem; }
    .testimonial-arrow.right { right: 1rem; }
    .testimonial-dots { display: flex; justify-content: center; gap: 0.5rem; margin-top: 1.5rem; }
    .testimonial-dot {
      border-radius: 100px; border: none; cursor: pointer;
      height: 0.625rem; background: #c8ccd8; transition: all 0.3s;
    }
    .testimonial-dot.active { background: var(--gold); width: 2rem; }
    .testimonial-dot:not(.active) { width: 0.625rem; }
    .testimonial-thumbs { display: flex; justify-content: center; gap: 0.75rem; margin-top: 1rem; }
    .testimonial-thumb {
      border-radius: 0.75rem; overflow: hidden; border: none; cursor: pointer; padding: 0;
      outline: 2.5px solid transparent; outline-offset: 2px;
      opacity: 0.45; transform: scale(1); transition: all 0.3s;
    }
    .testimonial-thumb.active { outline-color: var(--gold); opacity: 1; transform: scale(1.08); }
    .testimonial-thumb img { width: 3.5rem; height: 3.5rem; object-fit: cover; display: block; }

    /* ── Team ── */
    .team-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
      gap: 1.75rem;
    }
    .team-card { overflow: hidden; }
    .team-photo { position: relative; height: 22rem; background: #f0f2f7; overflow: hidden; }
    .team-photo img {
      width: 100%; height: 100%; object-fit: cover; object-position: top;
      transition: transform 0.5s var(--ease-out); display: block;
    }
    .team-photo:hover img { transform: scale(1.04); }
    .team-photo-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(20,30,56,0.75) 0%, transparent 55%);
    }
    .team-oab-badge {
      position: absolute; bottom: 1rem; left: 1rem;
      background: rgba(255,255,255,0.15); backdrop-filter: blur(12px);
      border-radius: 100px; padding: 0.375rem 0.875rem;
      border: 1px solid rgba(255,255,255,0.25);
      display: flex; align-items: center; gap: 0.375rem;
    }
    .team-info { padding: 1.75rem; }
    .team-name { font-family: "Poppins", sans-serif; font-weight: 700; font-size: 1.1875rem; color: var(--navy); margin-bottom: 0.25rem; }
    .team-role { font-size: 0.8125rem; font-weight: 600; color: var(--gold); margin-bottom: 1rem; }
    .team-bio { font-size: 0.875rem; color: #6b7280; line-height: 1.65; margin-bottom: 1.25rem; }
    .team-tags { display: flex; flex-wrap: wrap; gap: 0.375rem; }
    .team-tag {
      padding: 0.25rem 0.75rem; border-radius: 100px;
      background: var(--gold-pale); color: #8a6c1a;
      font-size: 0.6875rem; font-weight: 600;
    }

    /* ── FAQ ── */
    .faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 0.875rem; }
    .faq-item { overflow: hidden; }
    .faq-btn {
      width: 100%; display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; padding: 1.5rem 1.75rem; background: none; border: none; text-align: left;
    }
    .faq-btn-left { display: flex; align-items: center; gap: 1rem; }
    .faq-question {
      font-family: "Poppins", sans-serif; font-weight: 600;
      font-size: clamp(0.9375rem, 2vw, 1.0625rem); color: var(--navy); line-height: 1.3;
    }
    .faq-chevron { color: var(--gold); transition: transform 0.25s; flex-shrink: 0; }
    .faq-chevron.open { transform: rotate(180deg); }
    .faq-body { max-height: 0; overflow: hidden; transition: max-height 0.35s var(--ease-out); }
    .faq-body.open { max-height: 400px; }
    .faq-answer {
      margin-left: 3.25rem; padding: 1rem 1.75rem 1.5rem 0;
      border-top: 1px solid #eaecf4;
      font-size: 0.9375rem; color: #6b7280; line-height: 1.7;
    }

    /* ── Contact ── */
    .contact-grid {
      display: grid; grid-template-columns: 1fr; gap: 1.5rem;
      max-width: 900px; margin: 0 auto;
    }
    @media (min-width: 768px) { .contact-grid { grid-template-columns: 1fr 1fr; } }
    .contact-card {
      background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12);
      border-radius: 1.5rem; padding: 2.25rem;
    }
    .contact-info-row { display: flex; gap: 1.25rem; align-items: flex-start; }
    .contact-icon-wrap {
      width: 2.75rem; height: 2.75rem; border-radius: 0.875rem;
      background: rgba(255,255,255,0.10);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .contact-label {
      font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.10em;
      text-transform: uppercase; color: var(--gold); margin-bottom: 0.375rem;
    }
    .contact-cta-card {
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; text-align: center;
    }
    .wa-icon-wrap {
      width: 5rem; height: 5rem; border-radius: 1.5rem;
      background: var(--whatsapp); display: flex; align-items: center; justify-content: center;
      margin-bottom: 1.75rem; box-shadow: 0 8px 32px rgba(37,211,102,0.45);
    }

    /* ── Footer ── */
    footer {
      background: #0d1428; padding: 2.5rem 0;
    }
    .footer-inner {
      display: flex; flex-wrap: wrap; align-items: center;
      justify-content: space-between; gap: 1.5rem;
    }
    .footer-logo-mark {
      width: 2rem; height: 2rem; border-radius: 0.5rem;
      background: linear-gradient(160deg, #1e2f5c, #2a4080);
      display: flex; align-items: center; justify-content: center;
    }

    /* ── WhatsApp Float ── */
    #wa-float {
      position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 50;
      width: 3.5rem; height: 3.5rem; border-radius: 50%;
      background: var(--whatsapp); display: flex; align-items: center; justify-content: center;
      box-shadow: 0 6px 24px rgba(37,211,102,0.50); text-decoration: none;
      transition: transform 0.15s var(--ease-out), box-shadow 0.15s;
    }
    #wa-float:hover { transform: scale(1.10); box-shadow: 0 10px 32px rgba(37,211,102,0.60); }
    .wa-ping {
      position: absolute; inset: 0; border-radius: 50%;
      background: var(--whatsapp); opacity: 0.3;
      animation: ping 2s cubic-bezier(0,0,0.2,1) infinite;
    }
    @keyframes ping {
      75%, 100% { transform: scale(2); opacity: 0; }
    }

    /* ── Responsive helpers ── */
